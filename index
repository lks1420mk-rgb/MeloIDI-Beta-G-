<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="theme-color" content="#000000">
<title>MeloIDI</title>

<style>
:root {
  --accent:#777777;
  --tint:#292929;
  --ink:#f5f5f5;
  --panel:#171717;
  --bg:#000000;
}

* {
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
  /* テキスト選択や長押しメニューを完全に禁止 */
  -webkit-user-select:none;
  user-select:none;
  -webkit-touch-callout:none;
  touch-action:manipulation;
}

html {
  background:#000;
  overflow-x:hidden;
}

body {
  margin:0;
  position:relative;
  min-height:100svh;
  background:var(--bg);
  color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;
  overflow-x:hidden;
}

button,select,input {
  font:inherit;
}

header {
  padding:calc(env(safe-area-inset-top) + 10px) 14px 8px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.logo {
  font-size:23px;
  font-weight:800;
  letter-spacing:-1.2px;
}

.sub {
  font-size:8px;
  letter-spacing:2px;
  color:#888;
  margin-top:1px;
}

select {
  border:1px solid #444;
  border-radius:10px;
  padding:7px 24px 7px 9px;
  background:#222;
  color:#fff;
  max-width:170px;
  font-size:12px;
}

main {
  padding:0 11px 18px;
  max-width:760px;
  margin:auto;
}

.panel {
  background:var(--panel);
  border:1px solid #292929;
  border-radius:15px;
  padding:11px;
  margin:8px 0;
}

.row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.label {
  font-size:10px;
  color:#999;
  letter-spacing:1px;
  font-weight:700;
}

.status {
  font-size:11px;
  color:#aaa;
  min-height:16px;
}

button {
  border:1px solid #383838;
  border-radius:10px;
  padding:8px 10px;
  background:#292929;
  color:#eee;
  font-weight:650;
  font-size:12px;
  cursor:pointer;
}

button:active {
  transform:scale(.97);
}

button:disabled {
  opacity:0.4;
  cursor:not-allowed;
  transform:none;
}

button.primary,
button.selected {
  background:var(--accent);
  color:#fff;
  border-color:var(--accent);
}

button.recording {
  background:#d94b45;
  color:#fff;
  border-color:#d94b45;
}

.controls {
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;
}

.controls button {
  flex:1;
  min-width:0;
  white-space:nowrap;
}

.octave {
  display:flex;
  align-items:center;
  gap:7px;
}

.octave button {
  font-size:18px;
  min-width:35px;
  padding:5px;
}

#octaveLabel {
  font-size:13px;
  font-weight:750;
  min-width:38px;
  text-align:center;
}

.theme-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
  margin-top:8px;
}

.theme {
  display:flex;
  align-items:center;
  gap:6px;
  padding:7px 6px;
  border:1px solid #383838;
  text-align:left;
  font-size:11px;
  min-width:0;
  background:#222;
}

.theme .swatch {
  width:14px;
  height:14px;
  border-radius:50%;
  flex:none;
  background:var(--c);
}

.theme.active {
  outline:2px solid var(--accent);
  border-color:transparent;
  background:#303030;
}

.theme span:last-child {
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.keyboard-wrap {
  margin:10px -4px 0;
  overflow-x:auto;
  overflow-y:hidden;
  overscroll-behavior-x:contain;
  padding:2px 4px 8px;
  /* 鍵盤エリアではブラウザのデフォルト選択動作を完全に遮断 */
  touch-action:none;
  -webkit-overflow-scrolling:touch;
}

.keyboard {
  position:relative;
  height:190px;
  display:flex;
  min-width:100%;
  width:max-content;
}

.white {
  position:relative;
  width:clamp(38px,10.8vw,59px);
  height:190px;
  background:#f5f5f5;
  border:1px solid #aaa;
  border-radius:0 0 7px 7px;
  z-index:1;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  padding-bottom:8px;
  color:#777;
  font-size:10px;
  flex:none;
}

.white.down {
  background:var(--tint);
  box-shadow:inset 0 -5px var(--accent);
}

.black {
  position:absolute;
  top:0;
  width:clamp(24px,6.6vw,35px);
  height:118px;
  background:linear-gradient(90deg,#111,#444 55%,#111);
  border-radius:0 0 5px 5px;
  z-index:3;
  transform:translateX(-50%);
  box-shadow:0 3px 4px #0008;
  color:#ddd;
  font-size:9px;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  padding-bottom:8px;
}

.black.down {
  background:var(--accent);
  box-shadow:0 3px 4px #0005;
}

.volume {
  width:100%;
  accent-color:var(--accent);
  touch-action:auto;
}

.note {
  font-variant-numeric:tabular-nums;
  font-size:17px;
  font-weight:750;
}

footer {
  text-align:center;
  color:#777;
  font-size:9px;
  padding:7px 0 14px;
}

@media(max-width:390px) {
  .theme
